{
    "name": "islandora/milliner",
    "description": "Microservice that puts Drupal content in Fedora",
    "type": "project",
    "license": "MIT",
    "require": {
        "ext-ctype": "*",
        "ext-iconv": "*",
        "ext-sodium": "*",
        "guzzlehttp/guzzle": "^7.4",
        "guzzlehttp/psr7": "^2.7",
        "islandora/chullo": "^2.0",
        "islandora/fedora-entity-mapper": "^1.0",
        "lexik/jwt-authentication-bundle": "^3.2",
        "php": "^8.4.1",
        "psr/http-message": "^2.0",
        "psr/log": "^3.0",
        "symfony/dotenv": "8.1.*",
        "symfony/flex": "^2.11",
        "symfony/framework-bundle": "8.1.*",
        "symfony/monolog-bundle": "^4.0",
        "symfony/runtime": "8.1.*",
        "symfony/security-bundle": "8.1.*",
        "symfony/string": "8.1.*",
        "symfony/translation": "8.1.*",
        "symfony/yaml": "8.1.*"
    },
    "require-dev": {
        "donatj/mock-webserver": "^2.10",
        "phpspec/prophecy-phpunit": "^2.5",
        "phpunit/phpunit": "^12.5",
        "squizlabs/php_codesniffer": "^3.13",
        "symfony/phpunit-bridge": "8.1.*"
    },
    "authors": [
        {
            "name": "Islandora Foundation",
            "email": "community@islandora.ca",
            "role": "Owner"
        },
        {
            "name": "Daniel Lamb",
            "email": "dlamb@islandora.ca",
            "role": "Maintainer"
        },
        {
            "name": "Jared Whiklo",
            "email": "jwhiklo@gmail.com",
            "role": "Developer"
        }
    ],
    "config": {
        "preferred-install": {
            "*": "dist"
        },
        "sort-packages": true,
        "allow-plugins": {
            "symfony/flex": true,
            "symfony/runtime": true
        }
    },
    "autoload": {
        "psr-4": {
            "App\\Islandora\\Milliner\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Islandora\\Milliner\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "check": [
            "vendor/bin/phpcs --standard=PSR2 src tests"
        ],
        "test": [
            "@check",
            "vendor/bin/phpunit --exclude-group integration"
        ],
        "integration": "vendor/bin/phpunit --group integration",
        "coverage": "vendor/bin/phpunit --exclude-group integration --coverage-clover clover.xml"
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "8.1.*"
        }
    }
}
